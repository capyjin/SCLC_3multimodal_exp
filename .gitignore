# Patient medical data -- MUST NOT be published to the remote (clinical
# records, PET-CT images, radiology report text). Kept locally only;
# configs/config.yaml + src/sclc/paths.py resolve these relative to the repo root.
# data/* (not data/) so the fold assignment under data/splits/ can be re-included --
# git cannot re-include a file whose parent directory is excluded.
data/*
!data/splits/

# Training outputs (checkpoints, OOF predictions, logs) are runtime
# artifacts, not source -- regenerate via main.py.
outputs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Model weights, in case any land outside outputs/
*.pt
*.pth
*.ckpt

# Local tool state, not project content
.omc/

# OS
.DS_Store
Thumbs.db

# Experiment run logs (runtime artifacts)
*.log

# 논문 원문 PDF는 저작권 자료이고 재다운로드가 가능하며 저장소를 무겁게 만든다.
# 정리 메모(survey/*.md)만 추적한다.
survey/*.pdf
survey/*.bak
